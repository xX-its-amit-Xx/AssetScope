# ---------------------------------------------------------------------------
# AssetScope configuration. Copy to `.env` and fill in. All vars are optional
# except ANTHROPIC_API_KEY (required to run the live agent / API).
# ---------------------------------------------------------------------------

# --- LLM backend -----------------------------------------------------------
# "anthropic" (default) or "local"/"openai" for any OpenAI-compatible server
# (llama.cpp llama-server, Ollama, vLLM, ...). The agent loop is identical;
# only the client changes.
ASSETSCOPE_LLM_BACKEND=anthropic

# --- Anthropic (used when LLM_BACKEND=anthropic) ---------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the executor agent loop. Any current Claude model works.
ASSETSCOPE_ANTHROPIC_MODEL=claude-sonnet-4-6
# Model used for the planner (decomposition). Defaults to the executor model.
ASSETSCOPE_PLANNER_MODEL=claude-sonnet-4-6
ASSETSCOPE_MAX_TOKENS=4096

# --- Local / OpenAI-compatible model (used when LLM_BACKEND=local) ---------
# Example: run `llama-server -m <gguf> --port 8081` (or Ollama) and set:
ASSETSCOPE_LLM_BASE_URL=http://127.0.0.1:8081/v1
ASSETSCOPE_LLM_MODEL=qwen2.5-7b-instruct
ASSETSCOPE_LLM_API_KEY=local
ASSETSCOPE_LLM_MAX_TOKENS=1200
ASSETSCOPE_LLM_TEMPERATURE=0.2

# --- Agent budget ----------------------------------------------------------
ASSETSCOPE_MAX_TOOL_CALLS=16
ASSETSCOPE_MAX_ITERATIONS=12

# --- Database (PostgreSQL + pgvector) --------------------------------------
# In docker-compose this is set to the `db` service automatically.
ASSETSCOPE_DATABASE_URL=postgresql://assetscope:assetscope@localhost:5432/assetscope

# --- Embeddings ------------------------------------------------------------
ASSETSCOPE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ASSETSCOPE_EMBEDDING_DIM=384
# Set to 1 to use a deterministic hashing embedder (no torch download). Useful
# for CI / tests / demos. The agent and retrieval still work, just with weaker
# semantic matching.
ASSETSCOPE_USE_FAKE_EMBEDDINGS=0

# --- External API etiquette ------------------------------------------------
# NCBI rewards an email + (optional) API key with higher rate limits.
ASSETSCOPE_CONTACT_EMAIL=you@example.com
ASSETSCOPE_PUBMED_API_KEY=
ASSETSCOPE_HTTP_TIMEOUT=30

# --- Server ----------------------------------------------------------------
ASSETSCOPE_LOG_LEVEL=INFO
ASSETSCOPE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
